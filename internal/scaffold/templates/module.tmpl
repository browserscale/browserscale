package main

import (
	"github.com/browserscale/browserscale-kit/form"
	"github.com/browserscale/browserscale-kit/module"
	"github.com/browserscale/browserscale-kit/proxy"
)

// Config is this module's typed configuration. It is bound to the form in
// Schema() and edited through the configurator TUI when you run the module,
// then persisted as data/config.json. Add whatever fields your task needs —
// string/int/bool/select/file/list are all supported.
type Config struct {
	CloudKey    string `json:"cloudKey"`
	ProxiesFile string `json:"proxiesFile"`
{{- if eq .Threading "configurable"}}
	Threads int `json:"threads"`
{{- end}}
{{- if eq .Kind "repeat"}}
	Amount int `json:"amount"`
{{- end}}
{{- if eq .Kind "scheduled"}}
	IntervalSeconds int `json:"intervalSeconds"`
{{- end}}
}

// Module is the automation unit. It implements module.Module: the harness
// calls Schema() to configure it, then Run() to execute it. pool is wired
// once in Run (loadProxies) and shared read-only by the workers.
type Module struct {
	cfg    *Config
	schema *form.Schema

	pool *proxy.Pool // rotating proxies; every rent draws one
}

// Name is the routing key / store namespace. Version is free-form semver.
func (m *Module) Name() string    { return "{{.Name}}" }
func (m *Module) Version() string { return "0.1.0" }

// Schema builds the config form once and memoizes it. Returning the same
// instance on every call is required so the configurator's edits stick.
func (m *Module) Schema() *form.Schema {
	if m.schema != nil {
		return m.schema
	}
	m.cfg = &Config{}
	f := form.New(m.Name(), "{{.Name}}", m.cfg)

	f.String("cloudKey", &m.cfg.CloudKey).
		Label("Browserscale API key").
		Help("Your browserscale.cloud key (sk_...).").
		Required()

	// Every run is proxied. TagProxies makes the configurator reject a file
	// with no parseable proxies before the run starts (the "verify" step).
	f.File("proxiesFile", &m.cfg.ProxiesFile).
		Label("Proxies").
		Help("One proxy per line: host:port[:user:pass]. Put the file under data/.").
		Tag(form.TagProxies).
		Default("proxies.txt").
		Required()
{{- if eq .Threading "configurable"}}

	f.Int("threads", &m.cfg.Threads).
		Label("Threads").
		Help("Concurrent workers.").
		Default(1).Min(1).Max(64).
		Required()
{{- end}}
{{- if eq .Kind "repeat"}}

	f.Int("amount", &m.cfg.Amount).
		Label("Amount").
		Help("Stop after this many successful runs.").
		Default(1).Min(1).
		Required()
{{- end}}
{{- if eq .Kind "scheduled"}}

	f.Int("intervalSeconds", &m.cfg.IntervalSeconds).
		Label("Interval (seconds)").
		Help("Seconds between scheduled runs.").
		Default(60).Min(1).
		Required()
{{- end}}

	// Add your own fields here. Remember to add the matching field to Config:
	//   f.Select("region", &m.cfg.Region).Option("us", "US").Option("de", "Germany")
	//   f.File("accounts", &m.cfg.Accounts).Label("Accounts").Tag(form.TagLines)
	//   f.StringList("countries", &m.cfg.Countries).Label("Countries")

	m.schema = f.Build()
	return m.schema
}

// threads is the worker count for this run.
func (m *Module) threads() int {
{{- if eq .Threading "single"}}
	return 1
{{- else if eq .Threading "fixed"}}
	return {{.FixedThreads}}
{{- else}}
	if m.cfg.Threads < 1 {
		return 1
	}
	return m.cfg.Threads
{{- end}}
}

// compile-time check that Module satisfies the interface.
var _ module.Module = (*Module)(nil)
