package main

import (
	"context"
	"errors"
	"fmt"
	"path/filepath"
	"strings"
	"sync"
	"sync/atomic"
	"time"

	"github.com/browserscale/browserscale-kit/input"
	"github.com/browserscale/browserscale-kit/logger"
	"github.com/browserscale/browserscale-kit/mail"
	"github.com/browserscale/browserscale-kit/module"
)

// Sentinel outcomes the queue status line counts separately. Return these from
// a named flow when the meaning is clear — plain errors count as Failed.
var (
	// ErrRetry: transient; worker logs it and moves on (or you re-enqueue).
	ErrRetry = errors.New("retry")
	// ErrInspect: unknown/unmapped page — leave the browser open if you need
	// to attach, and make Inspect visible on the status line immediately.
	ErrInspect = errors.New("unknown page — inspect")
)

// account is one row of the accounts CSV. Change these fields to match your
// CSV columns.
type account struct {
	email     string
	firstName string
	lastName  string
	password  string
	country   string
}

// Run wires the shared runtime state — the proxy pool and one kept-alive IMAP
// connection — then drains the accounts CSV across workers: every account is
// handled exactly once by whichever worker picks it up. When the queue drains
// the workers exit and Run returns. Edit freely — it's your code.
func (m *Module) Run(ctx context.Context, env module.Env) error {
	l := logger.NewLogger("[run]", env.Logger)

	rows, err := input.CSV(filepath.Join(env.FilesDirectory, m.cfg.AccountsCSV))
	if err != nil {
		return err
	}
	var accounts []account
	for i, r := range rows {
		if len(r) < 5 {
			continue
		}
		if i == 0 && strings.EqualFold(strings.TrimSpace(r[0]), "email") {
			continue // header row
		}
		accounts = append(accounts, account{
			email:     strings.TrimSpace(r[0]),
			firstName: strings.TrimSpace(r[1]),
			lastName:  strings.TrimSpace(r[2]),
			password:  strings.TrimSpace(r[3]),
			country:   strings.TrimSpace(r[4]),
		})
	}
	q := input.NewQueue(accounts)

	// Every rent draws a random proxy from this pool (loaded here, once).
	if err := m.loadProxies(env); err != nil {
		return err
	}

	// One IMAP connection for the whole run: FetchCode multiplexes over it, so
	// open it here and share it with every worker via the receiver.
	fetcher, err := mail.NewCodeFetcher(m.cfg.ImapHost, m.cfg.ImapPort, m.cfg.ImapUser, m.cfg.ImapPass)
	if err != nil {
		return err
	}
	defer fetcher.Stop()
	m.fetcher = fetcher

	st := &runStats{total: q.Len(), remaining: q.Remaining}
	statusDone := st.publish(ctx, env.Status)
	defer close(statusDone)

	l.Println("registering", q.Len(), "accounts across", m.threads(), "workers —", st.line())

	var wg sync.WaitGroup
	for i := 0; i < m.threads(); i++ {
		wg.Add(1)
		go func(id int) {
			defer wg.Done()
			for {
				select {
				case <-ctx.Done():
					return
				default:
				}
				acc, ok := q.Next()
				if !ok {
					return // queue drained
				}
				st.setActive(1)
				st.setLast(fmt.Sprintf("w%d %s", id, acc.email))
				err := m.runOnce(ctx, acc)
				st.setActive(-1)
				if err != nil {
					switch {
					case errors.Is(err, ErrInspect):
						st.addInspect()
						l.Error("INSPECT", "worker", id, acc.email, err)
					case errors.Is(err, ErrRetry):
						st.addRetry()
						l.Error("retry", "worker", id, acc.email, err)
					default:
						st.addFailed()
						l.Error("worker", id, acc.email, err)
					}
					continue
				}
				st.addSuccess()
				l.Success(acc.email, "registered")
				env.Output("registered.txt", acc.email, "append")
			}
		}(i)
	}
	wg.Wait()
	l.Success("queue drained —", st.line())
	return nil
}

// runOnce rents a browser (through a random proxy from the pool) and hands it
// to the flow. A dead proxy surfaces here as a rent error; the worker logs it
// and moves to the next account.
func (m *Module) runOnce(ctx context.Context, acc account) error {
	browser, err := m.rent(ctx)
	if err != nil {
		return err
	}
	defer browser.StopBrowser(ctx)
	return m.doTask(ctx, browser, acc)
}

// runStats feeds the host status line from the first second of the run so a
// too-strict success criterion (or a stuck Inspect) is visible immediately.
type runStats struct {
	total     int
	remaining func() int

	ok      atomic.Int64
	failed  atomic.Int64
	retry   atomic.Int64
	inspect atomic.Int64
	active  atomic.Int64

	mu   sync.Mutex
	last string
}

func (s *runStats) addSuccess() { s.ok.Add(1) }
func (s *runStats) addFailed()  { s.failed.Add(1) }
func (s *runStats) addRetry()   { s.retry.Add(1) }
func (s *runStats) addInspect() { s.inspect.Add(1) }
func (s *runStats) setActive(d int64) {
	s.active.Add(d)
}
func (s *runStats) setLast(v string) {
	s.mu.Lock()
	s.last = v
	s.mu.Unlock()
}

func (s *runStats) line() string {
	left := 0
	if s.remaining != nil {
		left = s.remaining()
	}
	s.mu.Lock()
	last := s.last
	s.mu.Unlock()
	out := fmt.Sprintf("OK:%d Retry:%d Inspect:%d Fail:%d | total:%d left:%d active:%d",
		s.ok.Load(), s.retry.Load(), s.inspect.Load(), s.failed.Load(),
		s.total, left, s.active.Load())
	if last != "" {
		out += " | " + last
	}
	return out
}

func (s *runStats) publish(ctx context.Context, status module.StatusFunc) chan struct{} {
	quit := make(chan struct{})
	if status == nil {
		return quit
	}
	go func() {
		t := time.NewTicker(time.Second)
		defer t.Stop()
		for {
			status(s.line())
			select {
			case <-ctx.Done():
				return
			case <-quit:
				return
			case <-t.C:
			}
		}
	}()
	return quit
}
