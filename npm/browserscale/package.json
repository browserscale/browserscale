{
  "name": "browserscale",
  "version": "0.0.0-dev",
  "private": true,
  "scripts": {
    "prepublishOnly": "node -e \"console.error('browserscale: this is the source template, not a publishable package. Run scripts/build-npm.mjs and publish dist/npm/browserscale instead.'); process.exit(1)\""
  },
  "description": "browserscale studio and its command line: describe the work, get a bot that runs it",
  "keywords": [
    "browserscale",
    "browser-automation",
    "ai-agent",
    "rpa",
    "cli"
  ],
  "homepage": "https://browserscale.cloud/studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/browserscale/browserscale.git"
  },
  "bugs": {
    "url": "https://github.com/browserscale/browserscale/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "browserscale": "bin/browserscale.js"
  },
  "files": [
    "bin/browserscale.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "preferGlobal": true,
  "optionalDependencies": {
    "@browserscale/darwin-arm64": "0.0.0-dev",
    "@browserscale/darwin-x64": "0.0.0-dev",
    "@browserscale/linux-arm64": "0.0.0-dev",
    "@browserscale/linux-x64": "0.0.0-dev",
    "@browserscale/win32-arm64": "0.0.0-dev",
    "@browserscale/win32-x64": "0.0.0-dev"
  }
}
